# ──────────────────────────────────────────────────────────────────────
# Voisso 환경변수 예시  (계약서 docs/CONTRACT.md 7절 기준)
#
#   cp .env.example .env   후 필요한 값만 채우면 된다.
#
# ★★ 키가 하나도 없어도 데모는 돌아간다. ★★
#   아무것도 채우지 않으면 Voisso는 "텍스트 모드"로 동작한다.
#   - 마이크·스피커 없이 텍스트로 대화를 주고받으며
#   - 사투리 정규화 → 부서 라우팅(근거 문장 포함) → 민원 카드 생성까지
#     전 과정을 그대로 확인할 수 있다.
#   비활성화되는 것은 음성 입출력과 LLM 기반 자연스러운 대화뿐이다.
#   처음 실행해 보는 사람은 이 파일을 복사만 하고 그대로 두어도 된다.
# ──────────────────────────────────────────────────────────────────────

# ── 대화 엔진 ────────────────────────────────────────────────────────

# 대화 LLM 제공자 — openai | anthropic | rule
#   비우면: 키가 있는 쪽을 자동으로 고른다(OpenAI 우선). 둘 다 없으면 rule.
#   rule  : LLM 을 아예 쓰지 않는다. 키가 있어도 규칙 엔진으로 돈다.
#   OpenAI 를 쓰면 STT(Whisper)와 OPENAI_API_KEY 하나를 공유한다.
VOISSO_AGENT_PROVIDER=

# 대화 턴에 쓸 모델.
#   비우면: OpenAI 는 gpt-5.6-terra, Anthropic 은 claude-sonnet-5.
#   실시간 통화라 **지연이 곧 사용성**이다. 어르신이 말을 마치고 응답까지
#   2~3초가 넘어가면 통화로 안 느껴진다.
#   처음에는 가장 싼 등급(gpt-5.6-luna)을 기본으로 뒀는데, 재보니 더 비싼
#   terra 가 더 빨랐다. 같은 프롬프트 3회 측정, 첫 토큰까지 시간(TTFT):
#       gpt-5.6-luna  : 1226ms → 전체 1718ms
#       gpt-5.6-terra :  772ms → 전체 1399ms
#   턴당 토큰이 적어(입력 ~1K / 출력 ~150) terra 를 써도 통화 한 건이 2센트
#   안쪽이다. 근거는 voisso/agent/providers.py 주석에 있다.
VOISSO_AGENT_MODEL=

# 민원 요약에 쓸 모델.
#   비우면: OpenAI 는 gpt-5.6-terra, Anthropic 은 claude-opus-5.
#   요약은 통화가 끝난 뒤 한 번만 돌고, 그 한 문장이 담당 공무원 대시보드에
#   그대로 뜬다. 지연보다 품질이 중요해서 대화 턴보다 상위 등급을 쓴다.
VOISSO_SUMMARY_MODEL=

# Claude API 키 — VOISSO_AGENT_PROVIDER=anthropic 일 때 사용.
#   발급: https://console.anthropic.com/
#   주의: Anthropic 경로만 SDK(`anthropic`)를 쓴다. requirements.txt 에 들어
#         있으므로 6단계(pip install)를 밟았으면 이미 설치돼 있다. 설치돼 있지
#         않으면 이 경로를 조용히 건너뛰고 OpenAI 또는 규칙 엔진으로 간다.
#         OpenAI 경로와 STT/TTS 는 SDK 없이 표준 라이브러리로만 호출한다.
#   없으면: OpenAI 키가 있으면 그쪽을 쓰고, 그것도 없으면 규칙 기반 폴백으로
#           동작한다. 대화가 단순해지고 요약이 투박해지지만 라우팅과
#           민원 카드 생성은 정상 동작한다.
ANTHROPIC_API_KEY=


# ── 음성 합성 (TTS) ──────────────────────────────────────────────────
#
# ⚠️ **개발·테스트 중에는 음성을 생성하지 마라** (계약서 docs/CONTRACT.md 5-D).
#   타입캐스트는 종량제다. 충전된 크레딧은 **발표와 촬영용**이고, 개발 중 반복
#   실행으로 소진되면 정작 시연 때 음성이 안 나온다. 실제로 한 번 그렇게 됐다.
#   이 파일에 typecast 를 넣어 두더라도, 테스트 서버는 셸에서 덮어써라:
#
#       VOISSO_TTS_PROVIDER=none \
#       VOISSO_DATA_DIR=/tmp/voisso-<자기포트> \
#       python3 -m server --port <자기포트>
#
#   스크립트는 전부 **기본값이 음성 없음**이고, 켜는 길은 명시적 플래그뿐이다
#   (`scripts/rehearsal.py --audio`, `server.e2e_check --audio`,
#    `scripts.tests.live_checks --allow-tts`).

# TTS 제공자 — typecast | elevenlabs | none
#   none       : 음성 출력 없음. 화면에 텍스트만 표시된다. (기본값, 키 불필요)
#   typecast   : 권장. 한국어 사투리 보이스를 제공하는 국내 서비스.
#                TYPECAST_API_KEY 가 함께 있어야 한다.
#   elevenlabs : 대안. ELEVENLABS_API_KEY 가 함께 있어야 한다.
#                한국어는 되지만 사투리 억양은 지원하지 않는다.
#   없으면: none 으로 간주한다.
VOISSO_TTS_PROVIDER=none

# 타입캐스트 API 키 — VOISSO_TTS_PROVIDER=typecast 일 때만 필요.
#   발급: https://typecast.ai
#   없으면: TTS가 자동으로 none 으로 떨어지고 텍스트만 출력된다.
TYPECAST_API_KEY=

# 사용할 타입캐스트 보이스 ID.
#   주의: 타입캐스트 API 는 보이스의 언어·억양 정보를 제공하지 않는다.
#         "이 보이스가 경상도 억양"이라고 API 로 확인할 방법이 없다는 뜻이다.
#         Voisso 가 만드는 것은 사투리 *텍스트* 이고(사투리 어휘·어미),
#         그것을 어떤 억양으로 읽을지는 순전히 보이스 선택에 달렸다.
#         억양까지 맞추려면 직접 들어보고 고르는 수밖에 없다.
#   없으면: 코드에 정의된 기본 보이스(Yongsik)를 쓴다.
TYPECAST_VOICE_ID=

# 타입캐스트 모델. 비우면 ssfm-v30.
TYPECAST_MODEL=

# 합성 언어. 비우면 ko. (STT 의 VOISSO_STT_LANGUAGE 와 별개다)
VOISSO_TTS_LANGUAGE=

# 말하는 속도. 0.5(느림) ~ 2.0(빠름).
#   고령자가 듣는 통화라 표준 속도(1.0)보다 느리게 잡는다. 어르신 대상 안내
#   음성은 천천히 또박또박 읽어주는 쪽이 알아듣기 쉽다.
#   0.85 아래로는 내려도 의미가 없다 — 측정해 보면 0.80 과 0.85 의 길이 차이가
#   실행 간 편차에 묻힌다. 0.85 가 실질적인 하한이다.
#   범위를 벗어난 값은 경고를 남기고 0.5~2.0 안으로 잘라서 쓴다.
#   없으면: 0.85 를 쓴다.
VOISSO_TTS_TEMPO=0.85

# ElevenLabs API 키 — VOISSO_TTS_PROVIDER=elevenlabs 일 때만 필요.
#   발급: https://elevenlabs.io/
#   없으면: TTS가 자동으로 none 으로 떨어진다.
ELEVENLABS_API_KEY=

# ElevenLabs 보이스 / 모델. 비우면 공개 데모 보이스와 eleven_multilingual_v2.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=


# ── 음성 인식 (STT) ──────────────────────────────────────────────────

# STT 제공자 — openai | none
#   none   : 음성 입력 없음. 브라우저에서 텍스트로 입력한다. (기본값, 키 불필요)
#   openai : OpenAI 음성 인식 API 사용. OPENAI_API_KEY 가 함께 있어야 한다.
#            로컬 모델이 아니라 클라우드 API다 (계약서 6절: 노트북 환경 제약).
#   없으면: none 으로 간주한다.
VOISSO_STT_PROVIDER=none

# 음성 인식 모델 — whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe | gpt-transcribe
#   비우면: gpt-4o-transcribe.
#   whisper-1 을 쓰지 않는 이유는 두 가지다. 한국어 품질이 낫고, **프라이밍
#   프롬프트 예산이 훨씬 크다**(whisper-1 은 224토큰 상한). 사투리 어휘를
#   미리 물려 주는 것이 이 프로젝트의 핵심이라 이 차이가 결정적이다.
VOISSO_STT_MODEL=

# 인식 언어. 비우면 ko.
VOISSO_STT_LANGUAGE=

# OpenAI API 키 — 음성 인식과 대화 LLM 이 **같이 쓴다.**
#   발급: https://platform.openai.com/
#   없으면: STT 가 none 으로 떨어져 텍스트 입력만 받고,
#           대화도 규칙 기반 폴백으로 동작한다.
OPENAI_API_KEY=


# ── 통화 상한 (폭주·과금 안전장치) ──────────────────────────────────

# 한 통화의 최대 턴 수. 비우면 24.
#   어르신이 말을 못 알아듣고 빙빙 도는 경우를 대비한 상한이다. 넘으면
#   통화를 끊지 않고 **있는 정보로 접수하고 마무리**한다.
VOISSO_MAX_TURNS=

# 한 통화가 쓸 수 있는 대화 토큰 상한. 비우면 60000.
#   넘어도 통화를 끊지 않고 정리 단계로 넘겨 접수는 마친다.
VOISSO_MAX_SESSION_TOKENS=

# LLM 에 넘길 최근 대화 왕복 수. 비우면 3.
#   전체 기록을 매번 보내면 토큰만 늘고 대부분 중복이다. 다만 되묻기·정정
#   처리가 직전 문맥에 의존하므로 최근 몇 턴은 반드시 남긴다.
VOISSO_MAX_HISTORY_EXCHANGES=

# 통화 화면·대시보드 정적 파일에 캐시 방지 헤더를 붙일지. 비우면 켜짐.
#   시연 직전에 고친 파일이 브라우저 캐시 때문에 반영되지 않는 사고를 막는다.
#   지자체가 실서비스로 올릴 때는 0 으로 끄면 된다.
VOISSO_NO_CACHE=


# ── 방언 변환 (선택) ─────────────────────────────────────────────────

# 사투리 변환은 기본적으로 **규칙 사전만** 쓴다(어휘 367개 / 어미 규칙 70개).
# 아래를 1 로 켜면 규칙 변환 결과를 LLM 이 한 번 더 다듬는다. 선택 기능이고,
# 꺼져 있어도 사투리 변환은 그대로 동작한다.
#   ANTHROPIC_API_KEY 가 없거나 anthropic 패키지가 없으면 자동으로 꺼진다.
VOISSO_DIALECT_LLM=

# 다듬기에 쓸 모델. 비우면 claude-opus-5.
VOISSO_DIALECT_LLM_MODEL=


# ── 데이터 ───────────────────────────────────────────────────────────

# 부서 데이터셋(gb_departments.json)과 전화번호 매핑(private/phone_map.json)을
# 찾는 디렉터리. 접수된 민원카드도 이 아래(complaints/)에 쌓인다.
#   없으면: ./data 를 사용한다. **처음 실행하는 사람은 그대로 두면 된다.**
#
# ⚠️ 여러 사람이 동시에 개발할 때는 **자기 테스트 서버가 여기에 쓰지 않게 하라**
#   (계약서 5-E). 포트를 나눠도 이 디렉터리를 공유하면 서로의 민원카드가 섞인다.
#       mkdir -p /tmp/voisso-<자기포트>
#       ln -sf "$PWD/data/gb_departments.json" /tmp/voisso-<자기포트>/
#       VOISSO_DATA_DIR=/tmp/voisso-<자기포트> python3 -m server --port <자기포트>
VOISSO_DATA_DIR=./data

# 부서 데이터 **파일**을 직접 지정한다. VOISSO_DATA_DIR 보다 우선한다.
#   합성 샘플을 물릴 때만 쓴다:
#     VOISSO_DATA_FILE=mcp_server/fixtures/sample_departments.json python3 -m mcp_server
#   비워 두는 것이 정상이다.
VOISSO_DATA_FILE=

# 접수된 민원카드를 저장할 디렉터리.
#   없으면: $VOISSO_DATA_DIR/complaints
VOISSO_COMPLAINTS_DIR=


# ── 서버 (6단계에서만 쓰인다) ────────────────────────────────────────

# 바인드 주소·포트. 없으면 127.0.0.1:8000.
#   통화 UI      → http://localhost:8000/call/
#   담당자 대시보드 → http://localhost:8000/dashboard/
VOISSO_HOST=
VOISSO_PORT=

# CORS 허용 출처. 콤마로 구분한다. 없으면 `*`(전부 허용).
#   `*` 와 자격증명을 같이 켜면 브라우저가 거부하므로, 운영에서는 도메인을
#   명시하는 쪽이 맞다. 로컬 데모는 비워 두면 된다.
VOISSO_CORS_ORIGINS=

# 메모리에 들고 있는 통화 세션의 수명(초)과 최대 개수.
#   없으면: 3600초 / 500개. 끊긴 통화가 쌓여 메모리를 먹는 것을 막는다.
VOISSO_SESSION_TTL_SEC=
VOISSO_MAX_SESSIONS=
